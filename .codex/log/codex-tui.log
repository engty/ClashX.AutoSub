+│   │   └── templates.rs       # 新增模板保存、快照管理命令
+│   ├── services/
+│   │   ├── subscription_service.rs  # 扩展融合、测速结果管理
+│   │   └── template_service.rs      # 新增模板解析、回滚
+│   ├── models/
+│   │   └── template.rs        # 描述模板结构与序列化
+│   └── utils/
+│       └── yaml.rs            # 封装 YAML 解析、校验
+└── tauri.conf.json
+
+tests/
+├── unit/                      # 新增 TemplateEditor、useTemplateEditor 单测
+├── integration/               # 扩展订阅刷新集成流程
+├── contract/                  # Rust 命令契约测试
