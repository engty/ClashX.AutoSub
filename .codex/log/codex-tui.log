+export interface ThemeCustomColorOverrides {
+  primary?: string;
+  secondary?: string;
+  background?: string;
+  accent?: string;
+  cssVariables?: Record<string, string>;
+}
+
+export interface ThemePerformanceSettings {
+  enableHardwareAcceleration: boolean;
+  debounceDelay: number;
+  preloadThemeResources: boolean;
+}
+
+export interface ThemeConfiguration {
+  mode: ThemeMode;
+  preferences: ThemePreferences;
+  customColors?: ThemeCustomColorOverrides;
+  performance: ThemePerformanceSettings;
+  lastUpdated: string;
+}
+
+export type SystemThemePreference = 'light' | 'dark';
+export type ThemeColorScaleKey = 50 | 100 | 200 | 300 | 400 | 500 | 600 | 700 | 800 | 900;
+export type ThemeColorScale = Record<ThemeColorScaleKey, string>;
+
+export interface WarmThemeColors {
+  tea: ThemeColorScale;
+  beige: ThemeColorScale;
+  cornsilk: ThemeColorScale;
+  papaya: ThemeColorScale;
+  buff: ThemeColorScale;
+}
+
+export interface ThemeColors {
+  background: string;
+  foreground: string;
+  primary: string;
+  secondary: string;
+  accent: string;
+  muted: string;
+  success: string;
+  warning: string;
+  error: string;
+  info: string;
+  card: string;
+  cardForeground: string;
+  popover: string;
+  popoverForeground: string;
+  border: string;
+  input: string;
+  ring: string;
+  warm: WarmThemeColors;
+}
+
+export interface ComputedThemeStyles {
+  colors: ThemeColors;
+  spacing: Record<string, string>;
+  typography: Record<string, string>;
+  shadows: Record<string, string>;
+  animations: Record<string, string>;
+}
+
+export interface ThemeError {
+  code: string;
+  message: string;
+  details?: unknown;
+  timestamp: string;
+}
+
+export interface ThemeState {
+  effectiveTheme: EffectiveTheme;
+  systemPreference: SystemThemePreference;
+  isTransitioning: boolean;
+  isLoading: boolean;
+  error: ThemeError | null;
+  computedStyles: ComputedThemeStyles;
+}
+
 export type Language = 'zh-CN' | 'en-US';
