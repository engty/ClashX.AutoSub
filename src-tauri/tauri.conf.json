{
  "package": {
    "productName": "ClashX AutoSub",
    "version": "0.1.0"
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "tauri": {
    "bundle": {
      "identifier": "com.clashx.autosub"
    },
    "windows": [
      {
        "label": "main",
        "title": "ClashX AutoSub",
        "width": 500,
        "height": 600,
        "minWidth": 500,
        "maxWidth": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
